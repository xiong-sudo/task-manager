# Supabase 项目配置（Project Settings → API Keys 里复制）
# URL：项目首页项目名下方，或顶部 Connect → App Frameworks
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 当前版本使用 publishable key（可公开、配套 RLS 策略使用）
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# 如果你更想用高权限的 secret key（绕过 RLS），改成下面这行、并把上面那行删掉：
# SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# 服务端口
PORT=3000
